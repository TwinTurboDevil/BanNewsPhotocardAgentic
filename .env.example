# Google Gemini API key
# Obtain from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Google Serper API keys (multi-key rotation supported)
# Obtain from https://serper.dev
SERPER_API_KEY_1=your_first_serper_key_here
SERPER_API_KEY_2=your_second_serper_key_here
SERPER_API_KEY_3=your_third_serper_key_here

# Ollama endpoint (default is fine for local Ollama installations)
OLLAMA_HOST=http://localhost:11434

# Pipeline mode selector: "open_source" for Qwen, "api" for Gemini
PIPELINE_MODE=open_source
